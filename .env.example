OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.4-nano
OPENAI_AGENT_VERBOSITY=medium
OPENAI_AGENT_MAX_TURNS=5
OPENAI_AGENT_TRACING=false
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_OUTPUT_MAX_PX=480
# active uses data/gumroad_merchant.sqlite. test uses the local write-enabled test copy.
GUMROAD_MERCHANT_PROFILE=active
# Optional explicit overrides. If set, these win over GUMROAD_MERCHANT_PROFILE.
# GUMROAD_MERCHANT_DB=data/gumroad_merchant.sqlite
# GUMROAD_MERCHANT_CHAT_DB=data/gumroad_merchant_chat.sqlite
REDIS_URL=redis://127.0.0.1:6379/0
XAI_VOICE_ENABLED=false
XAI_API_KEY=
